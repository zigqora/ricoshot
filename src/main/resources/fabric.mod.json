{
	"schemaVersion": 1,
	"id": "ricoshot",
	"version": "${version}",
	"name": "Ricoshot",
	"description": "A Minecraft mod that adds Ultrakill coin tossing and parrying mechanics.",
	"authors": [
		"zigqora"
	],
	"contact": {
		"homepage": "https://github.com/zigqora/ricoshot",
		"sources": "https://github.com/zigqora/ricoshot"
	},
	"license": "MIT",
	"icon": "assets/ricoshot/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"zigqora.ricoshot.Ricoshot"
		],
		"client": [
			"zigqora.ricoshot.client.RicoshotClient"
		]
	},
	"mixins": [
		"ricoshot.mixins.json",
		{
			"config": "ricoshot.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": ">=1.21.4 <1.22",
		"java": ">=21",
		"fabric-api": "*"
	}
}